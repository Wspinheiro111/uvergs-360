# =============================================================================
# UVERGS 360 — .gitignore
# CRÍTICO: segredos NUNCA devem entrar no repositório (§10 v4.2)
# =============================================================================

# Segredos — NUNCA commitar
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/

# Dependências
node_modules/
.pnpm-store/

# Build
.next/
dist/
build/
.turbo/

# Cache
.cache/
*.tsbuildinfo
.eslintcache

# Logs
*.log
logs/

# Banco — nunca commitar dumps de produção
*.sql.backup
*.dump
*.pgdump
db-backup/

# Coverage
coverage/
.nyc_output/

# Playwright
playwright-report/
test-results/

# OS
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
!.vscode/extensions.json

# Uploads locais de desenvolvimento
uploads/
tmp/

# Certificados de desenvolvimento (SSL local)
localhost.pem
localhost-key.pem
