# =============================================================================
# UVERGS 360 — Variáveis de Ambiente
# W9 Sistemas · v4.2 baseline
#
# INSTRUÇÃO: copie este arquivo para .env e preencha os valores reais
# NUNCA comite o arquivo .env no repositório
# .env está no .gitignore — se não estiver, ADICIONE IMEDIATAMENTE
# =============================================================================

# ---------------------------------------------------------------------------
# BANCO DE DADOS (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# App (usa app_user role — RLS ativo)
DATABASE_URL="postgresql://app_user:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/uvergs360?sslmode=require"

# Service Role (usa service_role — RLS bypass) — apenas para worker/migrations
# Em dev, pode ser a mesma URL com credenciais diferentes
DATABASE_URL_SERVICE="postgresql://service_role:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/uvergs360?sslmode=require"

# Banco de testes (separado — nunca misturar com dev/prod)
DATABASE_URL_TEST="postgresql://uvergs360:uvergs360_test_secret@localhost:5433/uvergs360_test"

# ---------------------------------------------------------------------------
# REDIS (BullMQ, sessões, rate limiting)
# ---------------------------------------------------------------------------
REDIS_URL="redis://:uvergs360_redis_secret@localhost:6379"

# ---------------------------------------------------------------------------
# AUTENTICAÇÃO (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Chave secreta para JWT e cookies — mínimo 32 caracteres aleatórios
# Gerar com: openssl rand -hex 32
AUTH_SECRET="GERAR_COM_OPENSSL_RAND_HEX_32"

# URL base da aplicação
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# ASSINATURA DE LINKS (Signed Access Links)
# ---------------------------------------------------------------------------
# Chave HMAC-SHA256 para assinar links de acesso
# Gerar com: openssl rand -hex 32
SIGNED_LINK_SECRET="GERAR_COM_OPENSSL_RAND_HEX_32"

# ---------------------------------------------------------------------------
# OBJECT STORAGE (S3-compatible)
# Dev: MinIO local | Prod: Cloudflare R2
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="uvergs360_minio"
STORAGE_SECRET_KEY="uvergs360_minio_secret"
STORAGE_BUCKET_PRIVATE="uvergs360-private"
STORAGE_BUCKET_PUBLIC="uvergs360-public"
STORAGE_REGION="sa-east-1"
# URL pública dos arquivos públicos (certificados verificáveis)
STORAGE_PUBLIC_URL="http://localhost:9000/uvergs360-public"

# ---------------------------------------------------------------------------
# EMAIL (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM_NAME="UVERGS 360"
EMAIL_FROM_ADDRESS="noreply@uvergs.org.br"
EMAIL_REPLY_TO="contato@uvergs.org.br"

# ---------------------------------------------------------------------------
# OBSERVABILIDADE (OpenTelemetry)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="uvergs360-api"
OTEL_ENVIRONMENT="development"

# ---------------------------------------------------------------------------
# FEATURE FLAGS — Overrides de desenvolvimento
# ---------------------------------------------------------------------------
# Em produção, as flags são gerenciadas via admin panel (tabela feature_flags)
# Em dev, podem ser overrideadas aqui para facilitar desenvolvimento
# FEATURE_GERADOR_INSTRUMENTO_FILIACAO=false
# FEATURE_NFS_E_EMISSAO=false

# ---------------------------------------------------------------------------
# 2FA / TOTP
# ---------------------------------------------------------------------------
# Chave de criptografia para totp_secret armazenado no banco
# Gerar com: openssl rand -hex 32
TOTP_ENCRYPTION_KEY="GERAR_COM_OPENSSL_RAND_HEX_32"

# ---------------------------------------------------------------------------
# APLICAÇÃO
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
WORKER_PORT="3001"

# URL base para certificados verificáveis (domínio controlado pela UVERGS)
CERTIFICATE_VALIDATOR_URL="https://certificado.uvergs.org.br/verificar"

# ---------------------------------------------------------------------------
# INTEGRAÇÕES EXTERNAS (preencher quando adapter for implementado)
# ---------------------------------------------------------------------------

# WhatsApp (Meta Cloud API) — F5
# META_WHATSAPP_TOKEN=""
# META_WHATSAPP_PHONE_ID=""
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
# META_WEBHOOK_VERIFY_TOKEN=""

# Pix/Pagamentos — F1
# PAYMENT_GATEWAY_API_KEY=""
# PAYMENT_GATEWAY_URL=""
# PAYMENT_WEBHOOK_SECRET=""

# NFS-e — F4
# NFSE_API_KEY=""
# NFSE_PROVIDER_URL=""
# NFSE_CERTIFICATE_PATH=""
# NFSE_CERTIFICATE_PASSWORD=""

# TSE/TRE (dados eleitorais) — F1
# TSE_API_BASE_URL="https://dadosabertos.tse.jus.br"
