{
  "name": "uvergs-360",
  "version": "0.1.0",
  "private": true,
  "description": "UVERGS 360 — Sistema Integrado de Gestão Institucional · W9 Sistemas",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:isolation": "turbo run test:isolation",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "turbo run db:generate --filter=@uvergs360/db",
    "db:migrate": "turbo run db:migrate --filter=@uvergs360/db",
    "db:studio": "turbo run db:studio --filter=@uvergs360/db"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.4"
}
